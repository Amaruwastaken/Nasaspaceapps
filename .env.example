# Public browser configuration, also injected by Vercel's Supabase integration.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Supported public aliases: NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY,
# SUPABASE_ANON_KEY. Set one URL and one public key.
# Optional private key for administrative scripts only; never used by the build.
SUPABASE_SERVICE_KEY=
