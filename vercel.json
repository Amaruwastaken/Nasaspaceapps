{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "Interfaz",
  "rewrites": [
    {
      "source": "/",
      "destination": "/Index.html"
    },
    {
      "source": "/styles.css",
      "destination": "/Style.css"
    },
